{
  "name": "nuxt-bakery-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:mock": "nuxt dev --dotenv .env.mock",
    "export:static": "node scripts/export-static.mjs",
    "mock:esign": "node --experimental-strip-types scripts/mock-esign-api.ts",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:dev": "node --test --experimental-strip-types tests/dev/*.test.ts",
    "test:integration": "npm run build && node --test --experimental-strip-types tests/integration/*.test.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.4",
    "nuxt-security": "2.7.0",
    "ofetch": "^1.5.1",
    "vue": "^3.5.44",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vercel/nft": "1.11.0",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "readdir-glob": "3.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "readdir-glob": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
