msgid "localized site content"
msgstr "多語系網站內容"

msgid "simple translation"
msgstr "簡易翻譯"

msgid "Custom permissions"
msgstr "自訂權限"

msgid "Can publish"
msgstr "可發佈"

msgid "Can submit translations"
msgstr "可提交翻譯"

msgid "Toggle all"
msgstr "全選／取消全選"

msgid "Toggle all add permissions"
msgstr "全選／取消全部新增權限"

msgid "Toggle all change permissions"
msgstr "全選／取消全部變更權限"

msgid "Toggle all delete permissions"
msgstr "全選／取消全部刪除權限"

msgid "Toggle all custom permissions"
msgstr "全選／取消全部自訂權限"

msgid "The username or password is incorrect, or this account is temporarily unavailable."
msgstr "帳號或密碼錯誤，或此帳號目前暫時無法登入。"

msgid "The email address or password is incorrect, or this account is temporarily unavailable."
msgstr "Email 或密碼錯誤，或此帳號目前暫時無法登入。"

msgid "Alias / display name"
msgstr "別名／姓名"

msgid "Used only for display. Sign-in uses the email account ID."
msgstr "僅供畫面顯示；登入時使用 Email 帳號 ID。"

msgid "Email (account ID)"
msgstr "Email（帳號 ID）"

msgid "A user with this email address already exists."
msgstr "已有使用者使用此 Email。"

msgid "Enter your email address"
msgstr "請輸入 Email"

msgid "The password must contain at least 12 characters."
msgstr "密碼至少必須包含 12 個字元。"

msgid "The password must contain an uppercase English letter."
msgstr "密碼至少必須包含 1 個英文大寫字母。"

msgid "The password must contain a lowercase English letter."
msgstr "密碼至少必須包含 1 個英文小寫字母。"

msgid "The password must contain a number."
msgstr "密碼至少必須包含 1 個數字。"

msgid "The password must contain a symbol."
msgstr "密碼至少必須包含 1 個特殊符號。"

msgid "Use at least 12 characters with uppercase, lowercase, number, and symbol."
msgstr "請使用至少 12 個字元，並包含英文大寫、英文小寫、數字及特殊符號。"

msgid "This password was recently used. Choose a different password."
msgstr "這組密碼最近使用過，請選擇其他密碼。"

msgid "The new password cannot match any of your 3 most recent passwords."
msgstr "新密碼不能與最近使用的 3 組密碼相同。"

msgid "Current password"
msgstr "目前密碼"

msgid "New password"
msgstr "新密碼"

msgid "Confirm new password"
msgstr "確認新密碼"

msgid "The current password is incorrect."
msgstr "目前密碼不正確。"

msgid "The two password fields did not match."
msgstr "兩次輸入的新密碼不一致。"

msgid "Change password"
msgstr "變更密碼"

msgid "Your password must be changed before you can continue."
msgstr "您必須先變更密碼，才能繼續使用後台。"

msgid "Save new password"
msgstr "儲存新密碼"

msgid "Sign out"
msgstr "登出"

msgid "Unable to sign in"
msgstr "目前無法登入"

msgid "Return to sign in"
msgstr "返回登入頁"

msgid "User created"
msgstr "使用者已建立"

#, python-format
msgid "User \"%(username)s\" was created successfully."
msgstr "使用者「%(username)s」已成功建立。"

#, python-format
msgid "Account \"%(email)s\" was created successfully."
msgstr "帳號「%(email)s」已成功建立。"

#, python-format
msgid "Display name: %(alias)s"
msgstr "別名／姓名：%(alias)s"

msgid "Copy this temporary password now. It will not be shown again."
msgstr "請立即複製這組臨時密碼，離開此頁後將不再顯示。"

msgid "Temporary password"
msgstr "臨時密碼"

msgid "Copy password"
msgstr "複製密碼"

msgid "Password copied."
msgstr "密碼已複製。"

msgid "The user must change this temporary password after signing in."
msgstr "此使用者登入後必須先變更臨時密碼。"

msgid "Back to users"
msgstr "返回使用者列表"

#, python-format
msgid "Your password will expire on %(date)s. %(days)d days remaining."
msgstr "密碼將於 %(date)s 到期，剩餘 %(days)d 天。"

msgid "Change password now"
msgstr "立即變更密碼"

msgid "Password expiry reminders"
msgstr "密碼到期提醒"

msgid "Active admin users whose passwords expire within 30 days."
msgstr "密碼將於 30 天內到期的有效後台使用者。"

msgid "Last password change"
msgstr "最後變更密碼時間"

msgid "Expiry date"
msgstr "到期日"

msgid "Status"
msgstr "狀態"

#, python-format
msgid "%(days)s days"
msgstr "%(days)s 天"

msgid "No active admin users have passwords expiring within 30 days."
msgstr "目前沒有密碼將於 30 天內到期的有效後台使用者。"

msgid "Authentication method"
msgstr "登入方式"

msgid "Windows Hello (passwordless)"
msgstr "Windows Hello（無密碼）"

msgid "Windows Hello enrolment"
msgstr "Windows Hello 註冊"

msgid "Windows Hello enrolment code"
msgstr "Windows Hello 註冊碼"

msgid "Copy this Windows Hello enrolment code now. It will not be shown again and expires in 15 minutes."
msgstr "請立即複製這組 Windows Hello 註冊碼；離開此頁後將不再顯示，並於 15 分鐘後失效。"

msgid "Copy code"
msgstr "複製註冊碼"

msgid "Code copied."
msgstr "註冊碼已複製。"

msgid "The user must open the Windows Hello enrolment page on the Windows computer they will use for administration."
msgstr "使用者必須在日後用來管理網站的 Windows 電腦上開啟 Windows Hello 註冊頁。"

msgid "The enrolment details are invalid or expired. Ask an administrator for a new code."
msgstr "註冊資料不正確或已失效，請向管理者索取新的註冊碼。"

msgid "The enrolment code is valid. Continue to register Windows Hello on this computer."
msgstr "註冊碼有效，請繼續在這台電腦上註冊 Windows Hello。"

msgid "Register Windows Hello"
msgstr "註冊 Windows Hello"

msgid "Validate enrolment code"
msgstr "驗證註冊碼"

msgid "This browser does not support Windows Hello."
msgstr "此瀏覽器不支援 Windows Hello。"

msgid "Waiting for Windows Hello…"
msgstr "正在等候 Windows Hello 驗證…"

msgid "Windows Hello was cancelled or timed out."
msgstr "Windows Hello 已取消或等候逾時。"

msgid "Windows Hello registration could not be completed. Please try again."
msgstr "無法完成 Windows Hello 註冊，請再試一次。"

msgid "Sign in with Windows Hello"
msgstr "使用 Windows Hello 登入"

msgid "Use Windows Hello on this computer to sign in without entering a username or password."
msgstr "使用這台電腦的 Windows Hello 登入，不必輸入帳號或密碼。"

msgid "Use Windows Hello on this computer to sign in without entering an email address or password."
msgstr "使用這台電腦的 Windows Hello 登入，不必輸入 Email 或密碼。"

msgid "Continue with Windows Hello"
msgstr "繼續使用 Windows Hello"

msgid "Sign in with a username and password instead"
msgstr "改用帳號及密碼登入"

msgid "Sign in with an email address and password instead"
msgstr "改用 Email 及密碼登入"

msgid "Sign in with a username and password"
msgstr "使用帳號密碼登入"

msgid "Sign in with an email address and password"
msgstr "使用 Email 及密碼登入"

msgid "Windows Hello sign-in could not be completed. Please try again."
msgstr "無法完成 Windows Hello 登入，請再試一次。"

msgid "Windows Hello management"
msgstr "Windows Hello 管理"

msgid "The Windows Hello credential was revoked."
msgstr "Windows Hello 登入憑證已撤銷。"

#, python-format
msgid "Copy the enrolment code for %(username)s now. It expires in 15 minutes and will not be shown again."
msgstr "請立即複製 %(username)s 的註冊碼；註冊碼將於 15 分鐘後失效，且不會再次顯示。"

#, python-format
msgid "Copy the enrolment code for %(email)s now. It expires in 15 minutes and will not be shown again."
msgstr "請立即複製 %(email)s 的註冊碼；註冊碼將於 15 分鐘後失效，且不會再次顯示。"

msgid "Manage registered Windows Hello credentials and issue one-time enrolment codes for admin users."
msgstr "管理已註冊的 Windows Hello 憑證，並為後台使用者產生一次性註冊碼。"

msgid "Active credentials"
msgstr "有效憑證"

msgid "Pending enrolment"
msgstr "待完成註冊"

msgid "Actions"
msgstr "操作"

#, python-format
msgid "Last used %(used)s"
msgstr "最後使用時間：%(used)s"

msgid "Revoke"
msgstr "撤銷"

msgid "None"
msgstr "無"

#, python-format
msgid "Expires %(expiry)s"
msgstr "失效時間：%(expiry)s"

msgid "Generate enrolment code"
msgstr "產生註冊碼"

msgid "No admin users were found."
msgstr "找不到後台使用者。"

msgid "Select at least one group or grant administrator access."
msgstr "請至少選擇一個群組，或勾選管理員。"
